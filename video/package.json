{
  "name": "ten-kings-video",
  "version": "1.0.0",
  "description": "Remotion teaser for the ten-kings manuscript: animated map in reign order plus one card per ruler.",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "prestudio": "npm run assets",
    "studio": "remotion studio src/index.ts",
    "prerender": "npm run assets",
    "render": "remotion render src/index.ts Trailer out/ten-kings-teaser.mp4 --codec=h264 --crf=20",
    "prestill": "npm run assets",
    "still": "remotion still src/index.ts Trailer out/still.png"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "private": true
}
